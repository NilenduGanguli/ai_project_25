# API Configuration
# - For local development: http://localhost:8005
# - For Docker (standalone): http://host.docker.internal:8005
# - For docker-compose: http://image-data-extractor:8005 (set automatically)
API_BASE_URL=http://localhost:8005

# MongoDB Configuration (for docker-compose)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=document_extraction

# Google API Key (required for backend)
GOOGLE_API_KEY=your_google_api_key_here
